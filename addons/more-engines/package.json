{
  "name": "@surea11y-lab/more-engines",
  "version": "1.0.0",
  "private": true,
  "description": "More scan engines for surea11y-lab, beside the built-in surea11y: axe-core, Alfa (Siteimprove), Pa11y and QualWeb. Each runs a scan step in its own way, for comparing engines or checking with one a team already uses.",
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@qualweb/act-rules": "^0.8.3",
    "@qualweb/best-practices": "^0.7.12",
    "@qualweb/core": "^0.7.43",
    "@qualweb/wcag-techniques": "^0.4.7",
    "@siteimprove/alfa-act": "^0.119.0",
    "@siteimprove/alfa-device": "^0.119.0",
    "@siteimprove/alfa-dom": "^0.119.0",
    "@siteimprove/alfa-puppeteer": "^0.84.2",
    "@siteimprove/alfa-rules": "^0.119.0",
    "@siteimprove/alfa-wcag": "^0.119.0",
    "@siteimprove/alfa-web": "^0.119.0",
    "axe-core": "^4.12.1",
    "pa11y": "^10.0.0"
  },
  "surea11yLab": {
    "engines": [
      "axe",
      "alfa",
      "pa11y",
      "pa11y-htmlcs",
      "qualweb",
      "qualweb-act",
      "qualweb-bp",
      "qualweb-wcag"
    ]
  },
  "scripts": {
    "test": "node --test engines/*.addon-spec.js"
  }
}

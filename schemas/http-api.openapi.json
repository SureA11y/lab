{
  "openapi": "3.1.0",
  "info": {
    "title": "surea11y-lab HTTP API",
    "version": "1",
    "description": "Start a run, follow it and take its report; or queue a batch and download its results (docs/http-api.md). There is no login: publish the server only where whoever reaches it may use it. Generated from src/server-side/http-api-schema.js by `npm run build:action-docs`; do not edit schemas/http-api.openapi.json by hand."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Whether the server is up",
        "responses": {
          "200": {
            "description": "Up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workflow-start": {
      "post": {
        "summary": "Start a run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "run-spec.v1.schema.json"
                  }
                ],
                "description": "A run spec (schemas/run-spec.v1.schema.json). type and specVersion may be left out here; dryRun: true asks for a dry run."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "runId"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "runId": {
                      "type": "string"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "What the run's check found worth saying but not refusing, such as an unknown field ignored."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A run that cannot work as asked: the run's fields, its steps, its scans' profiles and selectors, a navigate step's address, a secret not set in the server's environment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    },
                    "problems": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Every run slot (A11Y_MAX_RUNS) and every place to wait (A11Y_MAX_WAITING) taken: try again after Retry-After seconds",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workflow-progress": {
      "get": {
        "summary": "A run's log, from an index on",
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "The log index to start from: the last answer's nextIndex."
          }
        ],
        "responses": {
          "200": {
            "description": "The log",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "nextIndex",
                    "logs"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "nextIndex": {
                      "type": "integer"
                    },
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "time": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "depth": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown runId",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workflow-result": {
      "get": {
        "summary": "A run's result",
        "parameters": [
          {
            "name": "runId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Finished: done, cancelled or error. A failed run's error says why, beside the payload of what it got before it failed, or alone when it failed before its first scan. A run cancelled while it waited its turn has no payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "done",
                        "cancelled",
                        "error"
                      ]
                    },
                    "payload": {
                      "$ref": "report.v3.schema.json"
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "string"
                        },
                        "details": {
                          "type": "string"
                        },
                        "actionPath": {
                          "type": "string"
                        },
                        "actionType": {
                          "type": "string"
                        }
                      }
                    },
                    "dryRun": {
                      "type": "object",
                      "description": "A dry run's summary, as run-workflow.js --dry-run prints it."
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Still running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown runId",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/workflow-cancel": {
      "post": {
        "summary": "Cancel a run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "runId"
                ],
                "properties": {
                  "runId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancelling",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown runId",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/queue": {
      "get": {
        "summary": "The queue and its recent batches, with links to their results",
        "responses": {
          "200": {
            "description": "The queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/items": {
      "post": {
        "summary": "Queue a batch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "run"
                      ],
                      "properties": {
                        "run": {
                          "allOf": [
                            {
                              "$ref": "run-spec.v1.schema.json"
                            }
                          ],
                          "description": "A run spec (schemas/run-spec.v1.schema.json). type and specVersion may be left out here; dryRun: true asks for a dry run."
                        },
                        "row": {
                          "type": "integer"
                        },
                        "config": {
                          "$ref": "app-config.v1.schema.json"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "A run that cannot be queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Another batch is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/queue/settings": {
      "post": {
        "summary": "How many runs at once",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "concurrency": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The concurrency now",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/items/{itemId}/progress": {
      "get": {
        "summary": "A queued run's log",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "The log index to start from: the last answer's nextIndex."
          }
        ],
        "responses": {
          "200": {
            "description": "The log",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "nextIndex",
                    "logs"
                  ],
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "nextIndex": {
                      "type": "integer"
                    },
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "time": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          },
                          "depth": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/queue/items/{itemId}/cancel": {
      "post": {
        "summary": "Cancel a queued run",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Its status now",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/cancel": {
      "post": {
        "summary": "Cancel the batch",
        "responses": {
          "200": {
            "description": "What was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/sessions/{sessionId}/masked-fields": {
      "get": {
        "summary": "The secrets a batch needs typed",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/sessions/{sessionId}/resume": {
      "post": {
        "summary": "Supply them, and resume",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "values": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resumed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/sessions/{sessionId}/delete": {
      "post": {
        "summary": "Delete a finished batch",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/queue/sessions/{sessionId}/download.zip": {
      "get": {
        "summary": "The batch as a report package",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A zip",
            "content": {
              "application/zip": {}
            }
          }
        }
      }
    },
    "/queue/sessions/{sessionId}/items/{itemId}/download.zip": {
      "get": {
        "summary": "One run as a report package",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A zip",
            "content": {
              "application/zip": {}
            }
          }
        }
      }
    },
    "/workflows/actions": {
      "get": {
        "summary": "The step definitions",
        "responses": {
          "200": {
            "description": "The definitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/engine/capabilities": {
      "get": {
        "summary": "What surea11y can check: its options and the profiles it supports",
        "responses": {
          "200": {
            "description": "Its capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/engine/rules": {
      "get": {
        "summary": "surea11y's rules catalog",
        "responses": {
          "200": {
            "description": "The catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}

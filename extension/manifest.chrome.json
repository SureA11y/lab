{
    "manifest_version": 3,
    "name": "surea11y manual runner",
    "version": "0.1.0",
    "permissions": [
        "storage",
        "scripting",
        "activeTab",
        "tabs",
        "debugger"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [],
    "devtools_page": "devtools.html",
    "commands": {
        "run-a11y-scan": {
            "suggested_key": {
                "default": "Ctrl+Shift+X",
                "mac": "Command+Shift+X"
            },
            "description": "Run accessibility scan in the current inspected page"
        }
    }
}